# Harbour OS — backend environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# Required: Flask session secret key. Keep the real value only in .env or the
# hosting provider's environment settings; never commit it.
# Generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret

# Optional: enables the natural-language assistant. The backend supplies all
# factual context; Gemini is used only to explain that context.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: defaults to the existing SQLite file in backend/instance.
DATABASE_URL=sqlite:///plutii.db

# Comma-separated explicit frontend origins for credentialed CORS.
# Set this to the deployed Vercel origin in Render; do not use '*'.
CORS_ORIGINS=http://localhost:5173

# Set to "true" in Render production (HTTPS). This also selects SameSite=None.
# Keep false for local HTTP development, which selects SameSite=Lax.
COOKIE_SECURE=false
